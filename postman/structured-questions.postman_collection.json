{
  "info": {
    "_postman_id": "f3028b8e-0d7f-4fe1-9b64-2f6f9f2c3e91",
    "name": "Structured Questions (Full Flow)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin: List Years (no auth)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/questions/years",
          "host": ["{{baseUrl}}"],
          "path": ["api", "questions", "years"]
        }
      }
    },
    {
      "name": "Admin: List Parts (no auth)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/questions/parts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "questions", "parts"]
        }
      }
    },
    {
      "name": "Admin: List Papers (no auth)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/questions/papers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "questions", "papers"]
        }
      }
    },
    {
      "name": "App: List Years (auth)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/questions/years",
          "host": ["{{baseUrl}}"],
          "path": ["api", "questions", "years"]
        }
      }
    },
    {
      "name": "App: List Parts (auth)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/questions/parts?year=2026",
          "host": ["{{baseUrl}}"],
          "path": ["api", "questions", "parts"],
          "query": [
            { "key": "year", "value": "2026" }
          ]
        }
      }
    },
    {
      "name": "App: List Papers (auth)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/questions/papers?year=2026&part=Part%201",
          "host": ["{{baseUrl}}"],
          "path": ["api", "questions", "papers"],
          "query": [
            { "key": "year", "value": "2026" },
            { "key": "part", "value": "Part 1" }
          ]
        }
      }
    },
    {
      "name": "App: Get Questions (auth + paper)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/questions?year=2026&part=Part%201&paper=Paper%201",
          "host": ["{{baseUrl}}"],
          "path": ["api", "questions"],
          "query": [
            { "key": "year", "value": "2026" },
            { "key": "part", "value": "Part 1" },
            { "key": "paper", "value": "Paper 1" }
          ]
        }
      }
    },
    {
      "name": "App: Search Questions (auth + paper)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/questions/search?year=2026&part=Part%201&paper=Paper%201&search=fever",
          "host": ["{{baseUrl}}"],
          "path": ["api", "questions", "search"],
          "query": [
            { "key": "year", "value": "2026" },
            { "key": "part", "value": "Part 1" },
            { "key": "paper", "value": "Paper 1" },
            { "key": "search", "value": "fever" }
          ]
        }
      }
    },
    {
      "name": "Admin: Upload Structured Excel",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file" },
            { "key": "year", "value": "2026", "type": "text" },
            { "key": "part", "value": "Part 1", "type": "text" },
            { "key": "paper", "value": "Paper 1", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/questions-structured/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "questions-structured", "upload"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" }
  ]
}

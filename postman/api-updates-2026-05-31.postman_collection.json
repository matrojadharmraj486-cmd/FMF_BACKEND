              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sendToAll\": false,\n  \"userIds\": [\"{{userId}}\"],\n  \"title\": \"Notification title\",\n  \"body\": \"Notification body\",\n  \"data\": {\n    \"screen\": \"home\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/notifications/send-bulk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "notifications", "send-bulk"]
            }

            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sendToAll\": true,\n  \"userIds\": [],\n  \"title\": \"Notification title\",\n  \"body\": \"Notification body\",\n  \"data\": {\n    \"screen\": \"home\"\n  }\n}"

    {
      "name": "Notifications",
      "item": [
        {
          "name": "Mobile - Register FCM Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"fcm-device-token-here\",\n  \"platform\": \"android\",\n  \"deviceId\": \"device-id-here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "register"]
            },
            "description": "Mobile app should call this after login/app launch with current FCM token."
          }
        },
        {
          "name": "Admin - Send Bulk To Selected Users",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",

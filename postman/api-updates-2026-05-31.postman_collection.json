  "item": [
    {
      "name": "Banners",
      "item": [
        {
          "name": "Mobile - List Active Banners Sorted By Position",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/banners",
              "host": ["{{baseUrl}}"],
              "path": ["api", "banners"]
            },
            "description": "Returns active banners sorted by position ascending. Mobile should display response order."
          }
        },
        {
          "name": "Admin - List Banners",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/banner",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "banner"]
            },
            "description": "Admin list returns position in each banner object."
          }
        },
        {
          "name": "Admin - Create Banner JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageUrl\": \"https://example.com/banner.jpg\",\n  \"bannerType\": \"type1\",\n  \"position\": 1,\n  \"redirectionUrl\": \"/homeView\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/banners",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "banners"]
            }
          }
        },
        {
          "name": "Admin - Update Banner JSON",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bannerType\": \"type1\",\n  \"position\": 1,\n  \"redirectionUrl\": \"/homeView\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/banners/{{bannerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "banners", "{{bannerId}}"]
            }
          }
        }
      ]
    },

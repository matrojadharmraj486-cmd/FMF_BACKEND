            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/support-tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "support-tickets",
                "{{ticketId}}"
              ]
            }
          }

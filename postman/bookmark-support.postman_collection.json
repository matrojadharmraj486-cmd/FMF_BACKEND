                },
                {
                  "key": "priority",
                  "value": "high"
                },
                {
                  "key": "category",
                  "value": "Subscription"
                },
                {
                  "key": "search",
                  "value": "{{ticketNumber}}"
                }
              ]
            }
          }
        },
